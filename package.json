{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:preview": "VITE_STAGING_PREVIEW=true vite --host 127.0.0.1",
    "docs:check": "node scripts/check-docs.mjs",
    "backend:status": "node scripts/backend-status.mjs",
    "ci:failures": "node scripts/ci-failures.mjs",
    "build": "vite build && node scripts/check-build-boundaries.mjs",
    "build:dev": "vite build --mode development",
    "ios:build": "vite build --mode capacitor && cap sync ios",
    "ios:open": "cap open ios",
    "lint": "eslint . && npm run lint:repo",
    "lint:repo": "knip --no-config-hints && node scripts/check-repo-rules.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.agentic.json",
    "preview": "vite preview",
    "smoke:jev": "node scripts/smoke-jev.mjs",
    "test": "vitest run",
    "test:collaboration": "vitest run --config services/collaboration/vitest.config.ts",
    "start:collaboration": "tsx services/collaboration/src/index.ts",
    "test:watch": "vitest",
    "test:edge": "deno test --allow-read --allow-env=DEMO_CODE_PEPPER,STRIPE_SECRET_KEY,STRIPE_PRICE_ID,STRIPE_PRICE_LOOKUP_KEY,EXA_API_KEY,SUPABASE_URL,SUPABASE_ANON_KEY,SUPABASE_SERVICE_ROLE_KEY,SPARRING_INTEGRITY_SECRET,ELEVENLABS_API_KEY,ELEVENLABS_VOICE_ID,OPENROUTER_API_KEY,OPENROUTER_API_URL,WORKSPACE_INVITE_SECRET,WORKSPACE_INVITE_MAILER_URL,WORKSPACE_INVITE_MAILER_TOKEN,WORKSPACE_INVITE_MAILER_FORMAT,WORKSPACE_INVITE_BASE_URL,WORKSPACE_INVITE_ALLOWED_ORIGINS,WORKSPACE_INVITE_SERVICE_ROLE_KEY --allow-net=127.0.0.1 supabase/functions/",
    "test:db": "supabase test db && bash scripts/test-daily-quota.sh && bash scripts/test-workspace-invite-concurrency.sh && bash scripts/test-workspace-mutation-concurrency.sh",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:smoke": "playwright test --project=desktop-chromium --grep @smoke",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:sw": "node scripts/test-service-worker-offline.mjs",
    "test:e2e:staging": "playwright test --project=staging",
    "test:agentic": "bash .claude/skills/verify-debatelab/bin/verify.sh e2e run",
    "verify": "npm run docs:check && npm run lint && npm run typecheck && npm test && npm run test:collaboration && npm run test:edge && npm run build && npm run test:sw && P=$(bash .superset/e2e-port.sh) && CI=1 PORT=$P PLAYWRIGHT_BASE_URL=http://127.0.0.1:$P npm run test:e2e:smoke",
    "verify:full": "npm run verify && P=$(bash .superset/e2e-port.sh) && CI=1 PORT=$P PLAYWRIGHT_BASE_URL=http://127.0.0.1:$P npm run test:e2e"
  },
