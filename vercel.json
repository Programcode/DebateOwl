{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:page(debatelab|debate-lab|debatelab-ai|debatelab-app|what-is-debatelab|debatelab-by-programcode|about-debatelab)",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:page(debatelab|debate-lab|debatelab-ai|debatelab-app|what-is-debatelab|debatelab-by-programcode|about-debatelab)/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:page(debatelab|debate-lab|debatelab-ai|debatelab-app|what-is-debatelab|debatelab-by-programcode|about-debatelab)/:rest+",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/online-debate-timer-tool",
      "destination": "/online-debate-timer",
      "statusCode": 301
    },
    {
      "source": "/debate-argument-flowchart-tool",
      "destination": "/argument-flowchart",
      "statusCode": 301
    },
    {
      "source": "/debate-weighing-guide",
      "destination": "/how-to-weigh-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-impact-calculus",
      "destination": "/how-to-weigh-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-cross-examination-tips",
      "destination": "/how-to-cross-examine-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-note-taking-flowing",
      "destination": "/how-to-flow-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-case-generator",
      "destination": "/ai-debate-case-generator",
      "statusCode": 301
    },
    {
      "source": "/how-to-write-a-rebuttal-speech",
      "destination": "/how-to-practice-rebuttals",
      "statusCode": 301
    },
    {
      "source": "/wsdc-debate-practice",
      "destination": "/world-schools-debate",
      "statusCode": 301
    },
    {
      "source": "/ai-debate-evidence-research",
      "destination": "/debate-evidence-finder",
      "statusCode": 301
    },
    {
      "source": "/debate-evidence-verification",
      "destination": "/debate-evidence-finder",
      "statusCode": 301
    },
    {
      "source": "/debatelab-alternatives",
      "destination": "/best-ai-debate-tools",
      "statusCode": 301
    },
    {
      "source": "/ai-tools-for-debate-students",
      "destination": "/best-ai-debate-tools",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app-shell.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/login",
      "destination": "/app-shell.html"
    },
    {
      "source": "/share/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/expocit/sources",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://*.jam.dev https://launchigniter.com https://statics.startupbase.io; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://*.jam.dev; worker-src 'self' blob:; frame-src 'self' https://accounts.google.com https://*.jam.dev; connect-src 'self' https://*.jam.dev https://uziwdtkzofptihahfooo.supabase.co https://brifeyypjauyusmkptkx.supabase.co https://*.ingest.sentry.io https://*.sentry.io https://eu.i.posthog.com https://*.posthog.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(self), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/share/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(app-shell|404)\\.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/theme-init.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
