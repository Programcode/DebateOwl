{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [{ "type": "host", "value": "debate.pi-stack.org" }],
      "destination": "https://debateowl.com/:path",
      "statusCode": 301
    },
    {
      "source": "/:locale(hu|es)?/debatelab-:slug(pricing|vs-chatgpt|vs-debateclub|vs-windebate){/}?",
      "destination": "/debateowl-:slug",
      "statusCode": 301
    },
    {
      "source": "/:page(debatelab|debate-lab|debatelab-ai|debatelab-app|what-is-debatelab|debatelab-by-programcode|about-debatelab)",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:page(debatelab|debate-lab|debatelab-ai|debatelab-app|what-is-debatelab|debatelab-by-programcode|about-debatelab)/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:page(debatelab|debate-lab|debatelab-ai|debatelab-app|what-is-debatelab|debatelab-by-programcode|about-debatelab)/:rest+",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "(?<l>hu|es)" }],
      "destination": "/:l",
      "statusCode": 301
    },
    {
      "source": "/online-debate-timer-tool",
      "destination": "/online-debate-timer",
      "statusCode": 301
    },
    {
      "source": "/debate-argument-flowchart-tool",
      "destination": "/argument-flowchart",
      "statusCode": 301
    },
    {
      "source": "/debate-weighing-guide",
      "destination": "/how-to-weigh-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-impact-calculus",
      "destination": "/how-to-weigh-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-cross-examination-tips",
      "destination": "/how-to-cross-examine-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-note-taking-flowing",
      "destination": "/how-to-flow-in-debate",
      "statusCode": 301
    },
    {
      "source": "/debate-case-generator",
      "destination": "/ai-debate-case-generator",
      "statusCode": 301
    },
    {
      "source": "/how-to-write-a-rebuttal-speech",
      "destination": "/how-to-practice-rebuttals",
      "statusCode": 301
    },
    {
      "source": "/wsdc-debate-practice",
      "destination": "/world-schools-debate",
      "statusCode": 301
    },
    {
      "source": "/ai-debate-evidence-research",
      "destination": "/debate-evidence-finder",
      "statusCode": 301
    },
    {
      "source": "/debate-evidence-verification",
      "destination": "/debate-evidence-finder",
      "statusCode": 301
    },
    {
      "source": "/debatelab-alternatives",
      "destination": "/best-ai-debate-tools",
      "statusCode": 301
    },
    {
      "source": "/ai-tools-for-debate-students",
      "destination": "/best-ai-debate-tools",
      "statusCode": 301
    },
    {
      "source": "/debate-collapsing-strategy",
      "destination": "/debate-clash-points",
      "statusCode": 301
    },
    {
      "source": "/debate-prep-time-management",
      "destination": "/how-to-prepare-for-a-debate-tournament",
      "statusCode": 301
    },
    {
      "source": "/debate-block-file-guide",
      "destination": "/how-to-practice-rebuttals",
      "statusCode": 301
    },
    {
      "source": "/debate-pronunciation-and-delivery",
      "destination": "/debate-speech-structure",
      "statusCode": 301
    },
    {
      "source": "/ai-vs-traditional-debate-prep",
      "destination": "/ai-debate-practice",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app-shell.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/login",
      "destination": "/app-shell.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/app-shell.html"
    },
    {
      "source": "/share/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/expocit/sources",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(self), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/((?!embed/debate-timer$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://js.jam.dev https://recorder.jam.dev; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://js.jam.dev; worker-src 'self' blob:; frame-src 'self' https://accounts.google.com https://recorder.jam.dev; connect-src 'self' https://js.jam.dev https://recorder.jam.dev https://uziwdtkzofptihahfooo.supabase.co https://brifeyypjauyusmkptkx.supabase.co https://*.ingest.sentry.io https://*.sentry.io https://eu.i.posthog.com https://*.posthog.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/embed/debate-timer",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; form-action 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'none';"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/share/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(app-shell|404)\\.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/theme-init.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.png|favicon-72\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|icon-1024\\.png|icon-maskable-512\\.png|hero-visual\\.jpg|placeholder\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/(?!assets(?:/|$)|_vercel(?:/|$)|.*\\.(?:js|mjs|css|png|jpe?g|gif|webp|avif|svg|ico|txt|xml|json|map|webmanifest|woff2?)$).*$",
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "delete",
          "target": { "key": "access-control-allow-origin" }
        },
        {
          "type": "response.headers",
          "op": "delete",
          "target": { "key": "Access-Control-Allow-Origin" }
        }
      ]
    }
  ]
}
