[Unit]
Description=Sync DebateLab staging Supabase with main
Documentation=https://github.com/Programcode/DebateLab/blob/main/docs/staging.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/ops/debatelab-staging-sync/run.sh
Environment=PATH=%h/.nvm/versions/node/v24.20.0/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
