"New ${applicationName} debate" = "Új ${applicationName} vita";

"Generate a case in ${applicationName}" = "Eset generálása itt: ${applicationName}";
"Build a case with ${applicationName}" = "Vitaeset építése itt: ${applicationName}";

"Open my ${applicationName} library" = "Könyvtár megnyitása itt: ${applicationName}";
"Show my sources in ${applicationName}" = "Forrásaim megjelenítése itt: ${applicationName}";

