{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "local",
      "node": "22.23.2",
      "env": {
        "DEBATELAB_BUILD": "dev"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.2",
      "ios": {
        "simulator": true
      },
      "env": {
        "DEBATELAB_BUILD": "dev",
        "DEBATELAB_APP_GROUP": "group.com.pistack.debateowl"
      }
    }
  }
}
