{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,ts}",
        "scripts/staging/seed.mjs",
        "e2e/full-stack/fake-openrouter.mjs",
        "e2e.config.ts",
        "src/prerender/entry.tsx",
        "agentic/**/*.e2e.ts",
        "services/collaboration/src/index.ts",
        "services/collaboration/src/**/*.test.ts",
        ".claude/skills/verify-debatelab/bin/*.mjs",
        ".claude/skills/verify-debatelab/recipes/*.spec.ts",
        "e2e/**/*.setup.ts",
        ".claude/skills/verify-debatelab/playwright.verify.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.{mjs,ts}",
        "e2e/**/*.{ts,mjs}",
        "agentic/**/*.ts",
        "services/collaboration/src/**/*.ts",
        ".claude/skills/verify-debatelab/**/*.{ts,mjs}"
      ],
      "playwright": {
        "config": [
          "playwright.config.ts",
          "playwright.production.config.ts",
          "playwright.workspace.config.ts"
        ]
      },
      "ignore": [
        "src/lib/workspace/document-conversion.ts"
      ]
    },
    "packages/core": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/mobile": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/**/*.test.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "expo-updates",
        "expo-speech-recognition",
        "expo-widgets",
        "expo-quick-actions",
        "expo-core-spotlight",
        "expo-share-intent",
        "@expo/dom-webview"
      ]
    }
  },
  "ignoreBinaries": [
    "supabase"
  ],
  "ignoreDependencies": [
    "squawk-cli"
  ],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries"
  ]
}
